# Email Alerts (Gmail)
# Step 1: Enable 2FA on your Gmail account
# Step 2: Go to Google Account > Security > App Passwords > Generate
# Step 3: Paste the 16-character app password below (no spaces)
EMAIL_SENDER=your_gmail@gmail.com
EMAIL_APP_PASSWORD=your16charapppassword
EMAIL_RECIPIENT=your_email@gmail.com

# Broker API (fill when ready)
# Supported: upstox, angelone, zerodha
BROKER=
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCESS_TOKEN=
